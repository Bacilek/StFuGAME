SF_USER=
SF_PASS=
SF_CHARACTER=
# Optional, only if you have characters with the same name on multiple servers (e.g. s1.sfgame.cz)
SF_SERVER=

# Optional: more characters for the multi-character challenge (same account login/password/character format,
# one semicolon-separated line, no spaces, no quotes):
# SF_ACCOUNTS=login1|password1|character1;login2|password2|character2

# Optional: which characters autostart when the app launches (semicolon or comma separated names).
# If unset, only SF_USER/SF_CHARACTER autostarts and every SF_ACCOUNTS entry starts switched off in the app.
# SF_AUTOSTART=character1;character2
