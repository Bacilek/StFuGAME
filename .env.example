SF_USER=
SF_PASS=
SF_CHARACTER=
# Optional: a second login (e.g. the registration email) to retry with if SF_USER is rejected
# SF_USER_ALT=
# Optional, only if you have characters with the same name on multiple servers (e.g. s1.sfgame.cz)
SF_SERVER=

# Optional: more characters for the multi-character challenge (same account login/password/character format,
# one semicolon-separated line, no spaces, no quotes). A 4th field adds a fallback login (e.g. the registration
# email) for an account that rejects the username on its own:
# SF_ACCOUNTS=login1|password1|character1;login2|password2|character2|alt_login2
