SF_USER=
SF_PASS=
SF_CHARACTER=
# Optional: a second login (e.g. the registration email) to retry with if SF_USER is rejected
# SF_USER_ALT=
# Optional, only if you have characters with the same name on multiple servers (e.g. s1.sfgame.cz)
SF_SERVER=

# Optional: more characters for the multi-character challenge (same account login/password/character format).
# A 4th field adds a fallback login (e.g. the registration email) for an account that rejects the username on
# its own. Either one semicolon-separated line:
# SF_ACCOUNTS=login1|password1|character1;login2|password2|character2|alt_login2
# ...or one account per line, in quotes (no semicolons needed between lines):
# SF_ACCOUNTS="login1|password1|character1
# login2|password2|character2|alt_login2
# login3|password3|character3"

# Characters that ONLY do fortress attacks (soldiers) and collect the Academy's XP, nothing else (names separated by ;).
# Meant for your main character; switch it on/off in the app window like any other (e.g. only overnight).
# SF_ATTACK_ONLY=MainCharacter
